// ═════════════════════════════════════════════════════════════════════════════
//  Minimum data set — the business view of what a provider must supply,
//  mapped to the profiles and to the SQL-on-FHIR view columns.
// ═════════════════════════════════════════════════════════════════════════════

Logical: DCGMinimumDataSet
Id: DCGMinimumDataSet
Title: "DCG Minimum Data Set"
Description: "Data elements needed per person to compute the diabetes care-gap indicators and case phenotype DM-ADULT-CASE (v0.4). Each element maps to a profile element (FHIR mapping) and to the SQL-on-FHIR view column the pipeline reads (view mapping)."
Characteristics: #can-be-target
* person 1..1 BackboneElement "Person" "Demographics used for cohort eligibility and dimensions."
  * birthDate 1..1 date "Birth date" "Age at period end; cohort requires age 18 or older."
  * administrativeGender 1..1 code "Administrative gender" "Dimension: sex."
  * deceasedDate 0..1 dateTime "Date of death" "Excludes people who died on or before period end."
  * province 0..1 string "Province/territory of residence" "Dimension: province."
  * postalCode 0..1 string "Postal code" "First 3 characters → FSA (restricted dimension)."
  * syntheticFlag 0..1 boolean "Synthetic record" "True when the record comes from a synthetic generator (meta.security HTEST)."
  * serviceLanguage 0..1 code "Preferred service language" "Equity stratifier (PCHDCF Service Language). Restricted."
  * indigenousIdentity 0..1 CodeableConcept "Indigenous identity" "Equity stratifier (PCHDCF). Restricted; OCAP applies."
  * racializedGroup 0..1 CodeableConcept "Racialized group" "Equity stratifier (PCHDCF). Restricted."
* diabetesDiagnosis 0..* BackboneElement "Diabetes diagnosis" "Evidence for case phenotype DM-ADULT-CASE (a person may also qualify on two HbA1c results)."
  * code 1..1 CodeableConcept "Diabetes type" "SNOMED CT (type 1, type 2, secondary, unspecified) or ICD-10-CA (E10, E11, E13, E14 and children)."
  * setting 0..1 code "Care setting" "From the linked Encounter class: inpatient, emergency or ambulatory. Drives the hospital and ambulatory routes."
  * onsetDate 0..1 dateTime "Onset" "Cohort entry date; falls back to recordedDate."
  * recordedDate 0..1 dateTime "Recorded date" "Fallback when onset is missing."
  * verificationStatus 0..1 code "Verification status" "Refuted and entered-in-error diagnoses are ignored."
* complication 0..* BackboneElement "Diabetes complication" "Retinopathy, kidney disease, neuropathy, foot ulcer; acute events (ketoacidosis, hypoglycemia)."
  * code 1..1 CodeableConcept "Complication" "SNOMED CT or ICD-10-CA."
  * onsetDate 0..1 dateTime "Onset" "Must be on or before period end."
* comorbidity 0..* BackboneElement "Cardio-renal comorbidity" "Chronic kidney disease, atherosclerotic cardiovascular disease."
  * code 1..1 CodeableConcept "Comorbidity" "SNOMED CT or ICD-10-CA (N18; I20, I21, I25, I63, I70)."
* labResult 0..* BackboneElement "Lab result" "HbA1c, eGFR, urine ACR, LDL-C, glucose."
  * code 1..1 CodeableConcept "Test" "LOINC."
  * effectiveDate 1..1 dateTime "Specimen/result date" "Places the result in a lookback window."
  * value 0..1 Quantity "Result value" "Numeric value with UCUM unit; the pipeline standardises HbA1c to %, glucose and LDL to mmol/L, ACR to mg/mmol."
  * status 1..1 code "Result status" "final, amended or corrected are counted."
* bloodPressure 0..* BackboneElement "Blood pressure reading" "Latest reading in 12 months is used."
  * effectiveDate 1..1 dateTime "Measurement date" "Lookback placement."
  * systolic 1..1 Quantity "Systolic (mmHg)" "Target < 130."
  * diastolic 1..1 Quantity "Diastolic (mmHg)" "Target < 80."
* medicationOrder 0..* BackboneElement "Medication order" "Antihyperglycemics, statins, ACEi/ARB."
  * medication 1..1 CodeableConcept "Medication" "Ingredient named in text/display; ATC class recommended."
  * authoredOn 1..1 dateTime "Order date" "Order in last 12 months, or active, counts as on therapy."
  * status 1..1 code "Order status" "entered-in-error, cancelled and draft are ignored."
* medicationDispense 0..* BackboneElement "Pharmacy dispense" "Antihyperglycemics, statins, ACEi/ARB."
  * medication 1..1 CodeableConcept "Medication" "DIN / CCDD with ATC class recommended."
  * whenHandedOver 1..1 dateTime "Dispense date" "Dispense in last 12 months counts as on therapy."
* screeningProcedure 0..* BackboneElement "Screening procedure" "Eye exam, foot exam."
  * code 1..1 CodeableConcept "Procedure" "SNOMED CT."
  * performedDate 1..1 dateTime "Performed date" "Lookback placement (24 months eye, 12 months foot)."

Mapping: DCGMinimumDataSetToProfiles
Id: dcg-mds-to-profiles
Title: "DCG Minimum Data Set to DCG profiles"
Source: DCGMinimumDataSet
Target: "http://fhir.hac-poc.example/dcg"
* person.birthDate -> "DCGPatient: Patient.birthDate"
* person.administrativeGender -> "DCGPatient: Patient.gender"
* person.deceasedDate -> "DCGPatient: Patient.deceased[x]"
* person.province -> "DCGPatient: Patient.address.where(use='home').state"
* person.postalCode -> "DCGPatient: Patient.address.where(use='home').postalCode"
* person.syntheticFlag -> "DCGPatient: Patient.meta.security = v3-ActReason#HTEST"
* diabetesDiagnosis -> "DCGDiabetesCondition"
* diabetesDiagnosis.code -> "Condition.code"
* diabetesDiagnosis.onsetDate -> "Condition.onset[x]"
* diabetesDiagnosis.recordedDate -> "Condition.recordedDate"
* diabetesDiagnosis.verificationStatus -> "Condition.verificationStatus"
* person.serviceLanguage -> "DCGPatient: Patient.communication.where(preferred=true).language"
* person.indigenousIdentity -> "DCGPatient: Patient.extension:indigenousIdentity"
* person.racializedGroup -> "DCGPatient: Patient.extension:racializedGroup"
* diabetesDiagnosis.setting -> "Condition.encounter -> DCGEncounter.class"
* complication -> "DCGComplicationCondition"
* comorbidity -> "DCGComorbidityCondition"
* medicationDispense -> "DCGMedicationDispense"
* medicationDispense.whenHandedOver -> "MedicationDispense.whenHandedOver"
* labResult -> "DCGHbA1c | DCGeGFR | DCGUrineACR | DCGLDL | DCGGlucose"
* labResult.code -> "Observation.code"
* labResult.effectiveDate -> "Observation.effective[x]"
* labResult.value -> "Observation.valueQuantity"
* labResult.status -> "Observation.status"
* bloodPressure -> "DCGBloodPressure"
* bloodPressure.systolic -> "Observation.component:systolic.valueQuantity"
* bloodPressure.diastolic -> "Observation.component:diastolic.valueQuantity"
* medicationOrder -> "DCGMedicationRequest"
* medicationOrder.medication -> "MedicationRequest.medicationCodeableConcept"
* medicationOrder.authoredOn -> "MedicationRequest.authoredOn"
* medicationOrder.status -> "MedicationRequest.status"
* screeningProcedure -> "DCGDiabetesProcedure"
* screeningProcedure.performedDate -> "Procedure.performed[x]"

Mapping: DCGMinimumDataSetToViews
Id: dcg-mds-to-views
Title: "DCG Minimum Data Set to SQL-on-FHIR view columns"
Source: DCGMinimumDataSet
Target: "http://fhir.hac-poc.example/views"
* person.birthDate -> "dcg_patient.birth_date"
* person.administrativeGender -> "dcg_patient.administrative_gender"
* person.deceasedDate -> "dcg_patient.deceased_datetime / deceased_flag"
* person.province -> "dcg_patient.province"
* person.postalCode -> "dcg_patient.fsa"
* diabetesDiagnosis.code -> "dcg_condition.snomed_code / icd10ca_code"
* diabetesDiagnosis.setting -> "dcg_encounter.encounter_class (via dcg_condition.encounter_id)"
* person.serviceLanguage -> "dcg_patient.service_language"
* person.indigenousIdentity -> "dcg_patient.indigenous_identity"
* person.racializedGroup -> "dcg_patient.racialized_group"
* comorbidity.code -> "dcg_condition.snomed_code / icd10ca_code"
* medicationDispense.medication -> "dcg_medication_dispense.atc_code / med_text"
* medicationDispense.whenHandedOver -> "dcg_medication_dispense.when_handed_over"
* diabetesDiagnosis.onsetDate -> "dcg_condition.onset_datetime"
* diabetesDiagnosis.recordedDate -> "dcg_condition.recorded_date"
* diabetesDiagnosis.verificationStatus -> "dcg_condition.verification_status"
* complication.code -> "dcg_condition.snomed_code / icd10ca_code"
* labResult.code -> "dcg_observation.loinc_code"
* labResult.effectiveDate -> "dcg_observation.effective_datetime"
* labResult.value -> "dcg_observation.value_numeric + ucum_unit"
* labResult.status -> "dcg_observation.status"
* bloodPressure.effectiveDate -> "dcg_blood_pressure.effective_datetime"
* bloodPressure.systolic -> "dcg_blood_pressure.systolic"
* bloodPressure.diastolic -> "dcg_blood_pressure.diastolic"
* medicationOrder.medication -> "dcg_medication_request.med_code / med_display"
* medicationOrder.authoredOn -> "dcg_medication_request.authored_on"
* medicationOrder.status -> "dcg_medication_request.status"
* screeningProcedure.code -> "dcg_procedure.snomed_code"
* screeningProcedure.performedDate -> "dcg_procedure.performed_datetime"
