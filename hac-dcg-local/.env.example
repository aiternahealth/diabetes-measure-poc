# Copy to .env and fill in after `make medplum-up` (README step 3)
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Synthea cohort size (adults 18–90). In Synthea sample data ~5% of people have diabetes, so 2,000 adults
# should give 100+ people in the diabetes cohort; use 5000+ for breakdowns that survive suppression.
SYNTHEA_POPULATION=2000
SYNTHEA_SEED=20261119
# Measurement period end (all lookback windows are relative to it)
PERIOD_END=2026-09-30
